# Large raw data and sequence data
assemblies/
raw_data/
reads/
data/isolates_poc/
data/references/*.fa
data/references/*.fasta
data/references/*.fna
data/references/*.gff
data/references/*.gff3
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai

# Large bioinformatics files (anywhere in the project)
*.fna
*.fa
*.fasta
*.fas
*.faa
*.gff
*.gff3
*.hmm
*.dmnd
*.mmi

# bwa-mem2/samtools/faidx index files (regenerable, some >1 GB)
*.fa.0123
*.fa.amb
*.fa.ann
*.fa.bwt.2bit.64
*.fa.pac
*.fai
*.paf

# Raw NCBI download archives (regenerable, redundant with the extracted
# FASTA/GFF already excluded above)
*.zip

# Auto-generated result and temporary files
results/
logs/
benchmarks/
temp/
tmp/
.snakemake/
.pytest_cache/
busco_downloads/
*.log

# Python and editor artifacts
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/settings.json
.DS_Store
.claude/

# Credentials and secrets
.env
*.key

# Windows/NTFS metadata (e.g. for files downloaded via a WSL mount)
*:Zone.Identifier
