# Große Rohdaten und Sequenzdaten
assemblies/
raw_data/
reads/
data/isolates_poc/
data/references/*.fa
data/references/*.fasta
data/references/*.fna
data/references/*.gff
data/references/*.gff3
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai

# Große Bioinformatikdateien (überall im Projekt)
*.fna
*.fa
*.fasta
*.fas
*.faa
*.gff
*.gff3
*.hmm
*.dmnd
*.mmi

# bwa-mem2/samtools/faidx Indexdateien (regenerierbar, teils >1 GB)
*.fa.0123
*.fa.amb
*.fa.ann
*.fa.bwt.2bit.64
*.fa.pac
*.fai
*.paf

# Rohe NCBI-Download-Archive (regenerierbar, redundant mit extrahierten
# FASTA/GFF, die bereits oben ausgeschlossen sind)
*.zip

# Automatisch erzeugte Ergebnis- und temporäre Dateien
results/
logs/
benchmarks/
temp/
tmp/
.snakemake/
.pytest_cache/
busco_downloads/
*.log

# Python- und Editor-Artefakte
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/settings.json
.DS_Store
.claude/

# Zugangsdaten und Geheimnisse
.env
*.key

# Windows/NTFS Metadaten (z. B. bei Dateien via WSL-Mount heruntergeladen)
*:Zone.Identifier
