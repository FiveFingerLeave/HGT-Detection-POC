import itertools
import pandas as pd
import yaml

configfile: "config/config.yaml"

references = pd.read_csv(config["references_tsv"], sep="\t", dtype=str, keep_default_na=False)
genome_ids = references["genome_id"].tolist()

# Section 7.2: all undirected pairs of the 5-genome panel (10 pairs) -
# the document explicitly warns against a single Oryza anchor, which
# would systematically make the diversity of the other lineages appear
# absent; with only 5 genomes, the full pair set is feasible without
# extra effort and delivers the most complete synteny evidence for 7.3.
genome_pairs = list(itertools.combinations(genome_ids, 2))


def _n_contigs(genome_id):
    fai = f"data/references/{genome_id}.fa.fai"
    if os.path.exists(fai):
        with open(fai) as f:
            return sum(1 for _ in f)
    return None


# SyRI requires an equal chromosome/contig count between reference and
# query (whole-genome 1:1 chromosome mapping); pairs with LpKY97
# (9 contigs) or GCA059329645_1 (10) against the 7-contig genomes
# otherwise fail with "Unequal number of chromosomes" - see
# docs/decisions.md. nucmer/show-coords still run for all 10 pairs
# (they deliver raw alignment coverage even without SyRI classification).
syri_pairs = [
    (r, q)
    for r, q in genome_pairs
    if _n_contigs(r) is not None and _n_contigs(r) == _n_contigs(q)
]

with open(config["thresholds"]) as f:
    thresholds = yaml.safe_load(f)

# config/samples.tsv (pilot 10 test isolates) is created during Phase IV
# (Section 9) once the pilot stratification is decided; guard against its
# absence so earlier phases remain runnable on their own.
import os

if os.path.exists(config["samples_tsv"]):
    samples = pd.read_csv(config["samples_tsv"], sep="\t", dtype=str, keep_default_na=False)
    sample_ids = samples["sample_id"].tolist()
    # Section 9/10: only the isolates with actually downloaded raw reads
    # (downloaded_run != "NA") can be mapped - see docs/decisions.md,
    # 5 of 10 stratified pilot isolates currently qualify.
    mappable_samples = samples[samples["downloaded_run"] != "NA"]
    sample_fastq = {
        row["sample_id"]: f"data/longreads/{row['downloaded_run']}.fastq.gz"
        for _, row in mappable_samples.iterrows()
    }
    sample_preset = {
        row["sample_id"]: row["minimap2_preset"] for _, row in mappable_samples.iterrows()
    }
    mappable_sample_ids = mappable_samples["sample_id"].tolist()
else:
    samples = None
    sample_ids = []
    sample_fastq = {}
    sample_preset = {}
    mappable_sample_ids = []


